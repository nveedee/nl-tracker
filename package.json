{
  "name": "nl-tracker",
  "version": "1.0.0",
  "description": "Privater Tracker für die Schweizer National League 2026/27 – ELO, Tabelle, Spieler-Stats",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n SERVER,VITE -c blue,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node server/index.js",
    "dev:client": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server/index.js",
    "serve": "vite build && node server/index.js",
    "backtest": "node server/scripts/backtesting/run.js",
    "test:backtest": "node --test server/scripts/backtesting/run.test.js",
    "test:sim": "node --test src/playoffSim.test.js",
    "test:wheel": "node --test src/wheelGeometry.test.js"
  },
  "dependencies": {
    "express": "^4.19.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "vite": "^5.4.8"
  }
}
